
#include <stdint.h>
#include "mpfs_hal/mss_hal.h"
#include "drivers/mss/mss_mmuart/mss_uart.h"

#define CLINT_MTIME_ADDR    0x0200BFF8UL
#define TEST_UART           (&g_mss_uart4_lo)

extern void board_periph_init(void);

static void uart_puts(const char *s)
{
    MSS_UART_polled_tx_string(TEST_UART, (const uint8_t *)s);
}

static void uart_put_uint(uint32_t val)
{
    char buf[12];
    int i = 0;
    if (val == 0U) {
        uart_puts("0");
        return;
    }
    while (val > 0U && i < 11) {
        buf[i++] = (char)('0' + (val % 10U));
        val /= 10U;
    }
    while (i > 0) {
        uint8_t ch = (uint8_t)buf[--i];
        MSS_UART_polled_tx(TEST_UART, &ch, 1U);
    }
}

void u54_1(void)
{
    uint64_t last_tick;
    uint32_t count = 0U;
    uint8_t rx = 0U;

    clear_soft_interrupt();
    set_csr(mie, MIP_MSIP);

    board_periph_init();

    MSS_UART_init(TEST_UART,
                  MSS_UART_115200_BAUD,
                  MSS_UART_DATA_8_BITS | MSS_UART_NO_PARITY | MSS_UART_ONE_STOP_BIT);

    uart_puts("\r\n========================================\r\n");
    uart_puts(" MPFS Discovery Kit - MMUART4 Hello Test\r\n");
    uart_puts(" Type any key to echo...\r\n");
    uart_puts("========================================\r\n");

    last_tick = *(volatile uint64_t *)CLINT_MTIME_ADDR;

    while (1) {
        /* Echo received characters */
        if (MSS_UART_get_rx(TEST_UART, &rx, 1U) > 0U) {
            uart_puts("[RX] ");
            MSS_UART_polled_tx(TEST_UART, &rx, 1U);
            uart_puts("\r\n");
        }

        /* Print 1-second heartbeat (CLINT mtime runs at 1 MHz) */
        uint64_t now = *(volatile uint64_t *)CLINT_MTIME_ADDR;
        if ((now - last_tick) >= 1000000ULL) {
            last_tick = now;
            uart_puts("[MMUART4] Heartbeat #");
            uart_put_uint(count++);
            uart_puts("\r\n");
        }
    }
}